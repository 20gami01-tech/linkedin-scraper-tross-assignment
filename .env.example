# This server does NOT store LinkedIn credentials — callers supply their
# own LinkedIn session on every request via headers (see README "Auth"
# section: X-LinkedIn-Cookie, or X-LinkedIn-Email + X-LinkedIn-Password).

# Clients must send this value in an "X-API-Key" header to use the API at
# all. Leave blank to disable (not recommended for a public deployment).
API_KEY=change-me

# How long (seconds) a scraped profile is cached before re-fetching, scoped
# per caller.
CACHE_TTL_SECONDS=3600

PORT=8000
